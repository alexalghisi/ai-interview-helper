# AI Interview HelpER — environment
#
# Provider is Google Gemini by default (via the Vercel AI SDK, provider-swappable).
# Without a key the app runs a built-in MOCK generator so the full flow is
# demoable end to end. Add a key to get real Gemini answers + screen reading —
# no other config needed.

# Either name works (GOOGLE_GENERATIVE_AI_API_KEY takes precedence):
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: public origin printed on the phone QR (Cloudflare tunnel / HTTPS).
# PHONE_PUBLIC_ORIGIN=https://your-tunnel.example

# Optional model / latency overrides:
# ANSWER_MODEL=gemini-3.1-flash-lite
# VISION_MODEL=gemini-3.1-flash-lite
# TRANSCRIBE_MODEL=gemini-3.1-flash-lite
# ANSWER_MAX_TOKENS=512

# --- Access gate (recommended once reachable on a network) ---
# Set a shared password to require a login for the whole app (desktop + phone +
# APIs). If unset, the app stays OPEN (frictionless local dev) and logs a warning.
APP_ACCESS_PASSWORD=
# Optional: explicit secret used to sign the session cookie. If omitted, a
# secret is derived from APP_ACCESS_PASSWORD. Set a long random value in prod.
AUTH_SECRET=
